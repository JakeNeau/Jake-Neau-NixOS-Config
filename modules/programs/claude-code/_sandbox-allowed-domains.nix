# Domains the Claude Code bash sandbox may reach without prompting.
# Second-level wildcards only: bare `*` and `*.tld` are schema-rejected, and
# `*.x.y` matches strict subdomains, so each apex is listed alongside it.
[
  # Nix
  "nixos.org"
  "*.nixos.org"
  "cachix.org"
  "*.cachix.org"
  # Git hosting
  "github.com"
  "*.github.com"
  "*.githubusercontent.com"
  "ghcr.io"
  "gitlab.com"
  "*.gitlab.com"
  "codeberg.org"
  "*.codeberg.org"
  # Package registries
  "npmjs.org"
  "*.npmjs.org"
  "npmjs.com"
  "*.npmjs.com"
  "yarnpkg.com"
  "*.yarnpkg.com"
  "pypi.org"
  "*.pypi.org"
  "pythonhosted.org"
  "*.pythonhosted.org"
  "crates.io"
  "*.crates.io"
  "rubygems.org"
  "*.rubygems.org"
  "golang.org"
  "*.golang.org"
  "go.dev"
  "*.go.dev"
  "packagist.org"
  "*.packagist.org"
  "nuget.org"
  "*.nuget.org"
  # Container registries
  "docker.io"
  "*.docker.io"
  "docker.com"
  "*.docker.com"
  # Docs & Q&A
  "readthedocs.io"
  "*.readthedocs.io"
  "readthedocs.org"
  "rust-lang.org"
  "*.rust-lang.org"
  "mozilla.org"
  "*.mozilla.org"
  "stackoverflow.com"
  "*.stackoverflow.com"
  "stackexchange.com"
