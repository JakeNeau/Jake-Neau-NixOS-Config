#!/usr/bin/env bash
# PreToolUse gate on ExitPlanMode. A hook runs only shell, so it can't dispatch
# plan-verifier itself; instead it gates on a per-session marker Claude creates
# after verifying. The marker is consumed on success, forcing the next plan to
# re-verify.
set -euo pipefail

input=$(cat)

# session_id keys the marker; tolerate jq being absent.
jq_bin=$(command -v jq || true)
session=""
[ -n "$jq_bin" ] && session=$("$jq_bin" -r '.session_id // empty' <<<"$input" 2>/dev/null || true)
[ -n "$session" ] || session="unknown"

marker_dir="$HOME/.claude/plan-verifier-gate"
marker="$marker_dir/$session.verified"

# Verified: consume the marker and allow ExitPlanMode.
if [ -f "$marker" ]; then
  rm -f "$marker"
  exit 0
fi

mkdir -p "$marker_dir"
cat >&2 <<EOF
Plan not verified — ExitPlanMode is blocked.

Before presenting this plan for approval:
  1. Dispatch the plan-verifier subagent on the current plan file.
  2. Present its verdict to the user alongside the plan.
  3. If (and only if) the plan is ready, mark it verified and retry:
       touch "$marker"
     then call ExitPlanMode again.

If plan-verifier finds the plan not ready, refine it instead — do not touch the marker.
EOF
exit 2
