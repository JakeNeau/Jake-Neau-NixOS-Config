#!/usr/bin/env bash
# PreToolUse gate on Write|Edit|NotebookEdit enforcing CLAUDE.md §9. The hook
# stdin carries agent_type only for a subagent's call, so its presence means a
# delegated write (allow) and its absence a direct main-session write (block).
set -euo pipefail

input=$(cat)

# Tolerate jq being absent; empty agent_type (or malformed input) -> block.
jq_bin=$(command -v jq || true)
agent_type=""
file_path=""
if [ -n "$jq_bin" ]; then
  agent_type=$("$jq_bin" -r '.agent_type // empty' <<<"$input" 2>/dev/null || true)
  file_path=$("$jq_bin" -r '.tool_input.file_path // empty' <<<"$input" 2>/dev/null || true)
fi

# Delegated write — allow.
[ -n "$agent_type" ] && exit 0

# Claude's own working files under ~/.claude (plan-mode plans, auto-memory,
# task state) aren't project code, so they bypass the gate. Reject any `..`
# first — a traversal can start under ~/.claude yet resolve outside it.
case "$file_path" in
  *..*) ;;
  "$HOME"/.claude/*) exit 0 ;;
esac

cat >&2 <<'EOF'
Direct writes from the main session are blocked.

Every file write must go through a subagent (CLAUDE.md §9). Dispatch the
code-writer subagent to make this change — hand it the full task context, since
it sees none of this conversation.
EOF
exit 2
