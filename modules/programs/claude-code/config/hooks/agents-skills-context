#!/usr/bin/env bash
# Claude Code auto-loads only .claude/skills/, so this bridges the cross-tool
# .agents/skills/ convention by listing those skills at session start.
set -euo pipefail

input=$(cat)

jq_bin=$(command -v jq || true)
[ -n "$jq_bin" ] || exit 0

cwd=$("$jq_bin" -r '.cwd // empty' <<<"$input" 2>/dev/null || true)
[ -n "$cwd" ] || exit 0

root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$root" ] || root="$cwd" # non-git project: use cwd directly

# Progressive disclosure: surface only each skill's frontmatter (name/description)
# and path, never the full body — Claude reads the SKILL.md on demand when its
# description matches the task, mirroring how it treats native .claude/skills.
skills=""
for skill_file in "$root"/.agents/skills/*/SKILL.md; do
  # unmatched glob stays literal (nullglob off), so skip the non-file it yields
  [ -f "$skill_file" ] || continue
  # awk prints the lines strictly between the first and second `---` fences
  frontmatter=$(awk '/^---$/{n++; next} n==1{print} n==2{exit}' "$skill_file")
  skills="$skills

$skill_file
$frontmatter"
done

[ -n "$skills" ] || exit 0

context="Project skills under .agents/skills/ — Claude Code does not auto-load these. Read a skill's SKILL.md when its description matches your task:$skills"

"$jq_bin" -n --arg content "$context" \
  '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $content}}'
