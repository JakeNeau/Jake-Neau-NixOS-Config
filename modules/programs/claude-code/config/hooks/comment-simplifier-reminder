#!/usr/bin/env bash
# PostToolUse on ExitPlanMode. A hook can't dispatch a subagent, so instead of
# running comment-simplifier itself it injects a reminder to.
cat <<'EOF'
{
  "hookSpecificOutput": {
    "hookEventName": "PostToolUse",
    "additionalContext": "Plan approved — implementation is starting. After you finish ALL the planned edits, and BEFORE any verification (builds, tests, linters, or dispatching code-reviewer), dispatch the comment-simplifier subagent over your changed files (CLAUDE.md §2). Skip this only if code-writer is doing the implementation — it runs comment-simplifier itself."
  }
}
EOF
