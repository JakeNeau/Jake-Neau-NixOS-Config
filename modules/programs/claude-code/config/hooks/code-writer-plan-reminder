#!/usr/bin/env bash
# PostToolUse on ExitPlanMode. On plan approval, remind Claude to implement via
# code-writer — direct main-session edits are gated (code-writer-gate), so
# reaching for one would just be blocked.
cat <<'EOF'
{
  "hookSpecificOutput": {
    "hookEventName": "PostToolUse",
    "additionalContext": "Plan approved — now implement it by dispatching the code-writer subagent, NOT via direct main-session edits. Direct writes are blocked by a PreToolUse hook (CLAUDE.md §7), so delegation is mandatory. Hand code-writer the full task context, since it sees none of this conversation."
  }
}
EOF
