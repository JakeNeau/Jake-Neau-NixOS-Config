diff -ruN a/resets.ts b/resets.ts
--- a/resets.ts
+++ b/resets.ts
@@ -0,0 +1,32 @@
+const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+const pad = (n: number) => String(n).padStart(2, "0");
+
+export function formatReset(
+  resetsAt: string | number | null | undefined,
+  now: number,
+): string {
+  if (resetsAt === null || resetsAt === undefined) return "";
+  const exact = new Date(resetsAt).getTime();
+  if (Number.isNaN(exact)) return "";
+
+  // The API reports a reset up to a second either side of its minute.
+  const at = new Date(Math.round(exact / 60_000) * 60_000);
+  // Whole clock minutes, so the current time plus the countdown equals the clock.
+  const minutes = Math.max(
+    0,
+    at.getTime() / 60_000 - Math.floor(now / 60_000),
+  );
+  const days = Math.floor(minutes / 1440);
+  const hours = Math.floor((minutes % 1440) / 60);
+  const countdown = days
+    ? `${days}d${hours}h`
+    : hours
+      ? `${hours}h${minutes % 60}m`
+      : `${minutes}m`;
+
+  const day =
+    at.toDateString() === new Date(now).toDateString()
+      ? ""
+      : `${WEEKDAYS[at.getDay()]} `;
+  return ` ↻${countdown} ${day}${pad(at.getHours())}:${pad(at.getMinutes())}`;
+}
