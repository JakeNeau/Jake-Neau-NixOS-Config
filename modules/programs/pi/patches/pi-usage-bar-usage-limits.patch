diff -ruN a/src/footer-statuses.ts b/src/footer-statuses.ts
--- a/src/footer-statuses.ts
+++ b/src/footer-statuses.ts
@@ -0,0 +1,21 @@
+import { stripAnsi, truncatePlain } from "./format.ts";
+
+// pi-usage-limits publishes subscription limits and reset times under this key.
+const LIMITS_STATUS = "model-usage";
+
+export function footerStatuses(
+	statuses: ReadonlyMap<string, string>,
+	showSecondLine: boolean,
+): { lineOne: string | null; lineTwo: string | null } {
+	const lineOne: string[] = [];
+	let lineTwo: string | null = null;
+	for (const [key, value] of statuses) {
+		if (key === "pi-usage-bar" || value.trim().length === 0) continue;
+		if (showSecondLine && key === LIMITS_STATUS) lineTwo = stripAnsi(value);
+		else lineOne.push(truncatePlain(stripAnsi(value), 28));
+	}
+	return {
+		lineOne: lineOne.length > 0 ? lineOne.join(" ❯ ") : null,
+		lineTwo,
+	};
+}
