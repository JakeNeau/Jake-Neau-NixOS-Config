diff -ruN a/src/context-level.ts b/src/context-level.ts
--- a/src/context-level.ts
+++ b/src/context-level.ts
@@ -0,0 +1,36 @@
+import type { ThemeColor } from "@earendil-works/pi-coding-agent";
+import { formatTokens, progressBar } from "./format.ts";
+import type { UsageBarConfig } from "./types.ts";
+
+type ContextThresholds = Pick<
+	UsageBarConfig,
+	"warningThreshold" | "errorThreshold"
+>;
+
+export function contextColor(
+	percent: number | null | undefined,
+	config: ContextThresholds,
+): ThemeColor {
+	if (percent === null || percent === undefined) return "muted";
+	if (percent >= config.errorThreshold) return "error";
+	if (percent >= config.warningThreshold) return "warning";
+	return "success";
+}
+
+const WARNING_TEXT: Partial<Record<ThemeColor, string>> = {
+	warning: " consider new session",
+	error: " start new session",
+};
+
+export function contextSegment(
+	usage: { percent: number | null; contextWindow: number } | undefined,
+	config: ContextThresholds,
+	fg: (color: ThemeColor, text: string) => string,
+): string {
+	const percent = usage?.percent ?? null;
+	const gauge = usage
+		? `${progressBar(percent, 10)} ${percent !== null ? `${percent.toFixed(0)}%` : "—%"} (${formatTokens(usage.contextWindow)})`
+		: `${progressBar(null, 10)} —`;
+	const color = contextColor(percent, config);
+	return fg(color, `${gauge}${WARNING_TEXT[color] ?? ""}`);
+}
