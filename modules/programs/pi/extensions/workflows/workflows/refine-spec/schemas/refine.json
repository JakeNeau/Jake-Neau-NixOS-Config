{
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactKind", "outcome", "summary", "payload"],
  "properties": {
    "artifactKind": { "enum": ["refinement-proposal"] },
    "outcome": { "enum": ["proposed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "files"],
      "properties": {
        "design": { "type": "string", "minLength": 1, "maxLength": 30000 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "change"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "change": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    }
  }
}
