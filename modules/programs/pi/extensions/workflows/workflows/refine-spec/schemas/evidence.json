{
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactKind", "outcome", "summary", "payload"],
  "properties": {
    "artifactKind": { "enum": ["evidence"] },
    "outcome": { "enum": ["ready"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lens", "findings", "constraints", "openQuestions"],
      "properties": {
        "lens": { "enum": ["specification", "documentation", "implementation", "verification"] },
        "findings": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "path", "excerpt", "meaning"],
            "properties": {
              "claim": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "meaning": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "constraints": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 1000 } },
        "openQuestions": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 1000 } }
      }
    }
  }
}
