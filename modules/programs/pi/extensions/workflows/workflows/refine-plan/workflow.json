{
  "version": 1,
  "name": "refine-plan",
  "description": "Create or refine an implementation plan",
  "inputHint": "[specification or plan area]",
  "color": "accent",
  "entry": "refine",
  "terminalOutcomes": ["done"],
  "stages": {
    "refine": {
      "prompt": "stages/refine.md",
      "tools": ["read", "bash", "follow_link", "rust_code"],
      "readOnly": true,
      "inputs": ["workflow-input"],
      "outputSchema": "schemas/refine.json",
      "transitions": {
        "proposed": [["write"]]
      },
      "checkpoint": "proposal"
    },
    "write": {
      "prompt": "stages/write.md",
      "tools": ["read", "edit", "write", "follow_link"],
      "readOnly": false,
      "mutationPaths": ["$approved"],
      "inputs": ["refinement-proposal"],
      "outputSchema": "schemas/write.json",
      "transitions": {
        "done": []
      }
    }
  }
}
