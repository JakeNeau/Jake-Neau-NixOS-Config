{
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactKind", "outcome", "summary", "payload"],
  "properties": {
    "artifactKind": { "enum": ["write-result"] },
    "outcome": { "enum": ["done"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
