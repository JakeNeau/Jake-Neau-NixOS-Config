{
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactKind", "outcome", "summary", "payload"],
  "properties": {
    "artifactKind": { "enum": ["verification"] },
    "outcome": { "enum": ["passed", "failed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionCoverage", "architectureConsistency", "validation", "findings"],
      "properties": {
        "decisionCoverage": { "type": "boolean" },
        "architectureConsistency": { "type": "boolean" },
        "validation": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 1000 } },
        "findings": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 1000 } }
      }
    }
  }
}
