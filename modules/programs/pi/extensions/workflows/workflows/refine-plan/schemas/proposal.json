{
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactKind", "outcome", "summary", "payload"],
  "properties": {
    "artifactKind": { "enum": ["refinement-proposal"] },
    "outcome": { "enum": ["proposed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specificationPath", "design", "integration", "files", "decisions", "rejectedAlternatives", "risks", "assumptions"],
      "properties": {
        "specificationPath": { "type": "string", "minLength": 1, "maxLength": 500 },
        "design": { "type": "string", "minLength": 1, "maxLength": 30000 },
        "integration": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sections", "change"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "sections": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 300 } },
              "change": { "type": "string", "minLength": 1, "maxLength": 3000 }
            }
          }
        },
        "decisions": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 1000 } },
        "rejectedAlternatives": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 1000 } },
        "risks": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 1000 } },
        "assumptions": { "type": "array", "maxItems": 0, "items": { "type": "string", "maxLength": 1000 } }
      }
    }
  }
}
